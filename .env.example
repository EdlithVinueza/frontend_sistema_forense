# Variables de entorno para Veriart Frontend
# En desarrollo local, se puede dejar vacío para que use los fallbacks del devServer proxy.
# En producción (Azure Static Web Apps), configurar con los endpoints de Azure Container Apps.

VUE_APP_API_CERT=https://<modulo-b-analisis>.<region>.azurecontainerapps.io/api/v1/certificaciones
VUE_APP_API_AUTH=https://<modulo-validar>.<region>.azurecontainerapps.io/api/v1/auth
